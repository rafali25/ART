{
  "output": "results/art_expansion",
  "threads": 4,
  "maximum_pilot_records": 3,
  "maximum_pilot_download_bytes": 20000000,
  "retrieval_evalue": 0.001,
  "sequence_evalue": 1e-05,
  "domain_evalue": 1e-05,
  "minimum_ART_profile_coverage": 0.6,
  "hmm_database_size": "actual_protein_count",
  "calibration_reference_database_size": 2076,
  "stage1_records": [
    {
      "accession": "MW349128.1",
      "name": "Staphylococcus phage Machias",
      "selection_role": "near-relative positive challenge",
