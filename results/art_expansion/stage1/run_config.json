    },
    {
      "accession": "KU878088.1",
      "name": "Bacillus phage AR9",
      "selection_role": "related jumbo-phage genomic comparison, not a verified NART reference",
      "source": "ENA"
    },
    {
      "accession": "NC_016163.1",
      "name": "Yersinia phage phiR1-37",
      "selection_role": "jumbo-phage genomic comparison",
      "source": "NCBI"
    }
  ],
  "stage2_assembly_manifest": "config/art_stage2_assemblies.tsv",
  "stage2_maximum_records": 10,
  "stage3_enabled": false,
  "stage3_assembly_manifest": "",
